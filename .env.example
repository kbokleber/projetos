# ────────────────────────────────────────────────────────────
# Banco de dados
# ────────────────────────────────────────────────────────────
# Produção (PostgreSQL) — Coolify / VPS
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
#
# Dev local com docker-compose (sobe Postgres automaticamente):
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up postgres -d
DATABASE_URL="postgresql://projetos:projetos@localhost:5432/sistema_projetos"

# ────────────────────────────────────────────────────────────
# Auth.js (obrigatório) — gere com: openssl rand -base64 32
# ────────────────────────────────────────────────────────────
AUTH_SECRET="gere-um-segredo-aleatorio-com-openssl-rand-base64-32"
# URL público da aplicação (sem barra no final)
NEXTAUTH_URL="http://localhost:3000"

# ────────────────────────────────────────────────────────────
# Seed de desenvolvimento (apenas local)
# ────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"

# ────────────────────────────────────────────────────────────
# API pública — origens permitidas para CORS (separadas por vírgula)
# ────────────────────────────────────────────────────────────
API_ALLOWED_ORIGINS="http://localhost:3000"

# ────────────────────────────────────────────────────────────
# Storage (futuro)
# ────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=